<?xml version="1.0" encoding="utf-8"?>
<!-- Widget del objetivo (2x2): cuenta regresiva, avance del período y peso con su tendencia semanal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_bg" android:paddingHorizontal="16dp" android:paddingVertical="16dp">
    <TextView android:id="@+id/goal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Río 2027" android:textColor="#8A8A8A" android:textSize="13sp" android:maxLines="1" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <TextView android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="81" android:textColor="#FFFFFF" android:textSize="44sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" días" android:textColor="#8A8A8A" android:textSize="14sp" android:layout_marginBottom="9dp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/period_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="2dp" android:max="100" android:progress="20" android:indeterminate="false" android:progressDrawable="@drawable/widget_progress" />
    <TextView android:id="@+id/period" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Semana 3 de 14" android:textColor="#8A8A8A" android:textSize="12sp" />
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <TextView android:id="@+id/weight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="76,1 kg" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/delta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginBottom="2dp" android:text="↓0,3" android:textColor="#22C55E" android:textSize="14sp" />
    </LinearLayout>
    <TextView android:id="@+id/target" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="meta 70,5 kg · en 7 días" android:textColor="#8A8A8A" android:textSize="12sp" />
</LinearLayout>
