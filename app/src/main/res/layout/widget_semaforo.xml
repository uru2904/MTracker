    </LinearLayout>
    <LinearLayout android:id="@+id/col3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/dot3" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/dot_gray" android:layout_marginEnd="4dp" />
            <TextView android:id="@+id/name3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Peso" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1" />
