        <TextView android:id="@+id/val1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="hoy" android:textColor="#8A8A8A" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/col2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
