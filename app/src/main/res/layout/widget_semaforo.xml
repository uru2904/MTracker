<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Semáforo" (4x1): los cinco temas de la notificación diaria, con su dato en gris. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@drawable/widget_bg" android:paddingHorizontal="8dp" android:gravity="center_vertical">
    <LinearLayout android:id="@+id/col0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/dot0" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/dot_gray" android:layout_marginEnd="4dp" />
            <TextView android:id="@+id/name0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Proteínas" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/val0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="146/150 g" android:textColor="#8A8A8A" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/col1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
