<?xml version="1.0" encoding="utf-8"?>
<!-- Notificación diaria expandida: una fila por tema, con punto de color, nombre y valor en gris. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="2dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" android:layout_marginBottom="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
        <ImageView android:id="@+id/dot0" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/name0" android:layout_width="76dp" android:layout_height="wrap_content" android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />
        <TextView android:id="@+id/value0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
        <ImageView android:id="@+id/dot1" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/name1" android:layout_width="76dp" android:layout_height="wrap_content" android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />
        <TextView android:id="@+id/value1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
        <ImageView android:id="@+id/dot2" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/name2" android:layout_width="76dp" android:layout_height="wrap_content" android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />
        <TextView android:id="@+id/value2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
        <ImageView android:id="@+id/dot3" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/name3" android:layout_width="76dp" android:layout_height="wrap_content" android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />
        <TextView android:id="@+id/value3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
        <ImageView android:id="@+id/dot4" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/name4" android:layout_width="76dp" android:layout_height="wrap_content" android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />
        <TextView android:id="@+id/value4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
    </LinearLayout>
</LinearLayout>
