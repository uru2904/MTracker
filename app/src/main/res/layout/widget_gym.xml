<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Gym" (2x2): próxima rutina, último entrenamiento y la semana. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_bg" android:padding="14dp" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Próxima" android:textColor="#8A8A8A" android:textSize="11sp" />
    <TextView android:id="@+id/next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Full B" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/last" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Última: hace 1 día" android:textColor="#8A8A8A" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="L" android:textColor="#8A8A8A" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="M" android:textColor="#8A8A8A" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="M" android:textColor="#8A8A8A" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="J" android:textColor="#8A8A8A" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="V" android:textColor="#8A8A8A" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="S" android:textColor="#8A8A8A" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="D" android:textColor="#8A8A8A" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d0" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d1" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d2" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d3" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d4" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d5" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d6" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
    </LinearLayout>
    <TextView android:id="@+id/week" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="2 / 3 esta semana" android:textColor="#8A8A8A" android:textSize="11sp" />
</LinearLayout>
