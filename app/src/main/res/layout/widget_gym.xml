<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Gym" (2x2): próxima rutina, último entrenamiento y la semana. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_bg" android:paddingHorizontal="16dp" android:paddingVertical="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Próxima rutina" android:textColor="#8A8A8A" android:textSize="13sp" />
    <TextView android:id="@+id/next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Full B" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" />
    <TextView android:id="@+id/last" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Última: hace 1 día" android:textColor="#8A8A8A" android:textSize="13sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="L" android:textColor="#8A8A8A" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="M" android:textColor="#8A8A8A" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="M" android:textColor="#8A8A8A" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="J" android:textColor="#8A8A8A" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="V" android:textColor="#8A8A8A" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="S" android:textColor="#8A8A8A" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="D" android:textColor="#8A8A8A" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d0" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d1" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d2" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d3" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d4" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d5" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"><ImageView android:id="@+id/d6" android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="center" android:src="@drawable/dot_track" /></FrameLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/week" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 / 3 esta semana" android:textColor="#FFFFFF" android:textSize="14sp" />
</LinearLayout>
