<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automático de Android (Android 12+): base y ajustes, en la nube y al pasar a otro celular. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
